# NOTE: This file ensures consistent line endings across Windows, macOS,
#       and Linux, preventing `git status` issues from CRLF/LF differences.
#       `* text=auto` normalizes text file line endings to LF in the repo
#       and converts to native OS on checkout. Explicitly marking file types
#       as `text` guarantees correct normalization, vital for cross-OS
#       development and avoiding spurious modifications.
* text=auto

# Ansible files
*.yml text eol=lf
*.yaml text eol=lf
ansible.cfg text eol=lf
hosts text eol=lf
.ansible-lint text eol=lf
.ansible-lint-ignore text eol=lf

# Scripts
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
# Installed and run on Linux; a CRLF shebang line fails ("python3\r: No such file").
roles/configure_keyboard/files/xkb/* text eol=lf
roles/configure_keyboard/files/alacritty/* text eol=lf

# Configuration files
*.cfg text
*.ini text

# Vimscript
*.vim text

# Documentation
*.md text
*.txt text
